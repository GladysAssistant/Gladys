# eslint-plugin-react has not published an ESLint 10 peer range yet (7.37.5 is the latest),
# so a plain `npm install` fails with ERESOLVE. A narrower `overrides` entry for that peer is
# not enough: dropping this flag also re-resolves the react peer tree used by the preact/compat
# aliasing (react 17 -> 18) and makes `npm ci` reject the lockfile. Remove once the plugin
# supports ESLint 10.
legacy-peer-deps=true
