{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gladysassistant.com/schemas/energy-contracts/tariff.schema.json",
  "title": "Gladys energy tariff definition",
  "description": "Declarative tariff of an energy contract, interpreted by the Gladys rule engine (docs/specs/energy-contracts.md). Canonical owner: GladysAssistant/energy-contracts; the Gladys core embeds a copy and validates with its Joi mirror (server/lib/energy-contract/tariff.validate.js), which the sync test test/lib/energy-contract/tariff.schema.test.js checks on a shared fixture pack. This schema is the SYNTACTIC contract; the core validator additionally enforces the semantic rules JSON Schema cannot express, and the catalogue and the store indexer must run it (or its fixture pack) too: a consumption component needs a fallback or a last rule without `when`; tier.to_kwh must be greater than tier.from_kwh; component keys are unique; a tax only applies to components declared before it; every calendar referenced by a condition or a price_from_calendar is listed in tariff.calendars; template inputs ({{input:<key>}}) are substituted before validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tariff_version", "components"],
  "properties": {
    "tariff_version": {
      "const": 1
    },
    "calendars": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/calendarKey"
      },
      "description": "Every calendar referenced by a condition or a price_from_calendar must be listed here."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/definitions/component"
      },
      "description": "Evaluated in order; component keys are unique; a tax only applies to components declared before it."
    }
  },
  "definitions": {
    "calendarKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "componentKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "time": {
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
    },
    "monthDay": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "calendarValue": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "number"
        }
      ]
    },
    "calendarCondition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/calendarValue"
          },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/definitions/calendarValue"
            }
          }
        ]
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "time": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "$ref": "#/definitions/timeStart"
              },
              {
                "$ref": "#/definitions/time"
              }
            ]
          },
          "description": "Intervals in the contract timezone, start inclusive, end exclusive; an end at or before the start crosses midnight (an end equal to the start covers the whole day); 24:00 is accepted as an end."
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
          }
        },
        "months": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "season": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "$ref": "#/definitions/monthDay"
            },
            "to": {
              "$ref": "#/definitions/monthDay"
            }
          },
          "description": "Inclusive, repeated every year, crossing 1 January allowed."
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": {
              "$ref": "#/definitions/date"
            },
            "to": {
              "$ref": "#/definitions/date"
            }
          },
          "description": "Inclusive local dates; an absent to is open-ended."
        },
        "calendar": {
          "$ref": "#/definitions/calendarCondition"
        },
        "not_calendar": {
          "$ref": "#/definitions/calendarCondition"
        },
        "tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cumulative", "from_kwh"],
          "properties": {
            "cumulative": {
              "enum": ["day", "month", "billing_period"]
            },
            "from_kwh": {
              "type": "number",
              "minimum": 0
            },
            "to_kwh": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Open-ended when absent; must be greater than from_kwh (checked by the core validator)."
            }
          }
        },
        "power_threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["above_kw"],
          "properties": {
            "above_kw": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/definitions/label"
        },
        "when": {
          "$ref": "#/definitions/conditions"
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "price_from_calendar": {
          "$ref": "#/definitions/calendarKey"
        },
        "multiplier": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "type": "number"
        }
      },
      "oneOf": [
        {
          "required": ["price"],
          "not": {
            "anyOf": [
              {
                "required": ["multiplier"]
              },
              {
                "required": ["offset"]
              }
            ]
          },
          "description": "A fixed price never carries multiplier nor offset."
        },
        {
          "required": ["price_from_calendar"]
        }
      ]
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/definitions/label"
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "price_from_calendar": {
          "$ref": "#/definitions/calendarKey"
        },
        "multiplier": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "type": "number"
        }
      },
      "oneOf": [
        {
          "required": ["price"],
          "not": {
            "anyOf": [
              {
                "required": ["multiplier"]
              },
              {
                "required": ["offset"]
              }
            ]
          },
          "description": "A fixed price never carries multiplier nor offset."
        },
        {
          "required": ["price_from_calendar"]
        }
      ]
    },
    "periodConditions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "months": {
          "$ref": "#/definitions/conditions/properties/months"
        },
        "season": {
          "$ref": "#/definitions/conditions/properties/season"
        },
        "dates": {
          "$ref": "#/definitions/conditions/properties/dates"
        },
        "weekdays": {
          "$ref": "#/definitions/conditions/properties/weekdays"
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["key", "kind"],
      "properties": {
        "key": {
          "$ref": "#/definitions/componentKey"
        },
        "kind": {
          "enum": ["consumption", "fixed", "tax", "demand"]
        },
        "label": {
          "$ref": "#/definitions/label"
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "key": true,
            "kind": {
              "const": "consumption"
            },
            "label": true,
            "rules": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/definitions/rule"
              }
            },
            "fallback": {
              "$ref": "#/definitions/fallback"
            }
          },
          "description": "Needs a fallback or a last rule without when."
        },
        {
          "additionalProperties": false,
          "required": ["amount", "per"],
          "properties": {
            "key": true,
            "kind": {
              "const": "fixed"
            },
            "label": true,
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "per": {
              "enum": ["day", "month"]
            },
            "when": {
              "$ref": "#/definitions/periodConditions"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["rate", "applies_to"],
          "properties": {
            "key": true,
            "kind": {
              "const": "tax"
            },
            "label": true,
            "rate": {
              "type": "number",
              "minimum": 0,
              "description": "Percentage."
            },
            "applies_to": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/componentKey"
              },
              "description": "Keys of components declared before this one."
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["price", "per"],
          "properties": {
            "key": true,
            "kind": {
              "const": "demand"
            },
            "label": true,
            "price": {
              "type": "number",
              "minimum": 0,
              "description": "Per kW of aggregated peak power over the period."
            },
            "per": {
              "enum": ["month", "billing_period"]
            },
            "aggregation": {
              "enum": ["max", "top3_average"],
              "default": "max"
            },
            "when": {
              "$ref": "#/definitions/periodConditions"
            }
          }
        }
      ]
    },
    "timeStart": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Start of an interval: never 24:00."
    }
  }
}
